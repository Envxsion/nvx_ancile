{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NVX Ancile",
  "version": "0.1.0",
  "identifier": "sh.nvx.ancile",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ancile"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "publisher": "nvx.sh",
    "category": "Productivity",
    "shortDescription": "Your self-hosted AI workspace",
    "longDescription": "NVX Ancile: notebooks that cite your sources, branching chats, memory you control, model flows you draw, and your own GPUs, all on your machine.",
    "copyright": "GPL-3.0-or-later",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecars/": "sidecars/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
