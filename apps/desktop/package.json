  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "NVX Ancile for the desktop: a Tauri shell that runs every service for you.",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "icons": "node scripts/icons.mjs",
    "sidecars": "node scripts/bundle.mjs",
    "dev": "tauri dev",
    "build": "node scripts/bundle.mjs && tauri build",
    "typecheck": "node --check scripts/bundle.mjs && node --check scripts/publish-release.mjs",
    "test": "node --test scripts/publish-release.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.28.2"
  }
}
