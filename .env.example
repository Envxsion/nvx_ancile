# ============================================================================
#  NVX Ancile: configuration
#
#  You do not need this file to start. `pnpm start` generates every secret on
#  first run (kept in .ancile/secrets.json) and uses the defaults below.
#  Copy it to .env only to change something: `cp .env.example .env`.
#  A value here always wins over a generated one. Blank means "use the default".
#  Every key is explained in docs/configuration.md.
# ============================================================================

# --- Secrets (blank = generated on first start) ----------------------------
# Encrypts provider keys stored by Core (AES-256-GCM, 32 bytes, base64).
# Back it up: without it you would re-enter your provider keys.
ANCILE_SECRET_KEY=
# Core <-> Knowledge.
ANCILE_SERVICE_TOKEN=
# Core <-> the lab engine, and the lab's key for model calls through Core.
AGENT_ENGINE_TOKEN=
AGENT_GATEWAY_TOKEN=
# Core <-> Controller, and GPU nodes -> Controller heartbeats.
CONTROLLER_TOKEN=
CONTROLLER_NODE_TOKEN=

# --- Database (embedded Postgres via pg0) ----------------------------------
POSTGRES_USER=ancile
POSTGRES_PASSWORD=
POSTGRES_DB=ancile
POSTGRES_PORT=5433
# Built from the four above when blank. Set it to use your own Postgres 16+
# with pgvector instead of the embedded one.
DATABASE_URL=

# --- Core -------------------------------------------------------------------
ANCILE_PORT=7700
# 127.0.0.1 keeps NVX Ancile on this machine. To reach it from your network,
# set 0.0.0.0 AND ANCILE_PASSPHRASE_REQUIRED=true.
ANCILE_HOST=127.0.0.1
ANCILE_PASSPHRASE_REQUIRED=false
ANCILE_PUBLIC_URL=http://localhost:7700
# Extra origins allowed to write to /api/v1 (comma-separated).
ANCILE_ALLOWED_ORIGINS=
ANCILE_DATA_DIR=data
# 1 = the offline test models answer before any key is added; 0 hides them.
ANCILE_OFFLINE_MODELS=1
# How many answers run at once.
ANCILE_RUN_CONCURRENCY=32
# Unanswered approvals expire after this many seconds (24 h).
ANCILE_APPROVAL_TTL_S=86400
# A lab run still going after this many seconds is stopped (30 min).
ANCILE_LAB_TIMEOUT_S=1800
# strict | warn | off
ANCILE_BOOT_TESTS=strict
# trace | debug | info | warn | error
ANCILE_LOG_LEVEL=info
ANCILE_LOG_RETENTION_DAYS=14

# --- Model providers (blank = not configured; you can also add keys in the app)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Memory (a git repository under data/memory) ----------------------------
# Who memory commits are written as (default: NVX Ancile <memory@ancile.local>).
ANCILE_MEMORY_AUTHOR_NAME=
ANCILE_MEMORY_AUTHOR_EMAIL=
# Optional git remote to back memory up to.
ANCILE_MEMORY_REMOTE=

# --- Knowledge --------------------------------------------------------------
KNOWLEDGE_URL=http://localhost:7710
KNOWLEDGE_PORT=7710
# Blank = <ANCILE_DATA_DIR>/knowledge and <ANCILE_DATA_DIR>/models.
KNOWLEDGE_DATA_DIR=
KNOWLEDGE_MODEL_CACHE=
KNOWLEDGE_MAX_UPLOAD_MB=200
KNOWLEDGE_MAX_FETCH_MB=50
# Off by default: a URL source must not reach your local network.
KNOWLEDGE_ALLOW_PRIVATE_URLS=false
KNOWLEDGE_WORKER=true
KNOWLEDGE_STALE_CHECK_HOURS=6
KNOWLEDGE_MODEL_DOWNLOAD=true
KNOWLEDGE_EMBED_BATCH=64
KNOWLEDGE_EMBED_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
KNOWLEDGE_USE_DOCLING=true
KNOWLEDGE_OCR=false
# A SearXNG instance for web evidence in fact-checks (optional).
SEARXNG_URL=

# --- Lab (opencode engine) --------------------------------------------------
AGENT_ENGINE_URL=http://localhost:7730
AGENT_ENGINE_PORT=7730

# --- Controller (GPU nodes) -------------------------------------------------
# Blank = the local Controller on CONTROLLER_PORT.
CONTROLLER_URL=
CONTROLLER_PORT=7720
# runpod | local (machines on your network) | fake (sample nodes, no GPU).
# With runpod and no RUNPOD_API_KEY, development uses the sample nodes.
CONTROLLER_PROVIDER=runpod
RUNPOD_API_KEY=
# Machines on your network running Ollama, vLLM or LM Studio, as a JSON list:
# [{"name":"Desk 3090","url":"http://192.168.1.20:11434/v1","gpu":"RTX 3090"}]
CONTROLLER_LOCAL_NODES=
# Stops routing to paid nodes once this month's spend reaches it.
CONTROLLER_COST_CAP_USD=150

# --- NVX Ancile Pro and usage statistics -------------------------------------
# free forces the free product even when pro/ is present.
NVX_TIER=
# Where anonymous usage statistics go once you agree to share them.
# Blank = never sent, whatever you choose in the app.
NVX_TELEMETRY_URL=